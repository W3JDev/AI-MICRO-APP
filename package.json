{
  "name": "ai-micro-app-builder",
  "version": "1.0.0",
  "description": "AI agent that builds smart micro apps from Google Sheets/Excel and forms with complete workflow management",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "npm run lint && npm test"
  },
  "keywords": [
    "ai",
    "micro-apps",
    "google-sheets",
    "excel",
    "forms",
    "workflow",
    "automation",
    "pdf",
    "digital-signature"
  ],
  "author": "W3JDev",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "googleapis": "^126.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "microsoft-graph": "^3.0.7",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "openai": "^4.8.0",
    "pdfkit": "^0.15.2",
    "rate-limiter-flexible": "^2.4.2",
    "redis": "^4.7.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.48.0",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
